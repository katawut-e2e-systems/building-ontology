@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://example.com/building-management>
  a owl:Ontology ;
  rdfs:label "Building Management Ontology (Brick + BOT)" ;
  owl:imports <https://example.com/building-management/modules/composition> .
