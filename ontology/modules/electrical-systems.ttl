@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bldg: <https://example.com/building-management#> .

<https://example.com/building-management/modules/electrical-systems>
  a owl:Ontology ;
  rdfs:label "Building management - electrical systems module" ;
  owl:imports
    <https://brickschema.org/schema/Brick#> ,
    <https://example.com/building-management/modules/site-structure> .

bldg:Panel_LP1
  a brick:Electrical_Panel ;
  rdfs:label "Lighting Panel LP-1" ;
  brick:hasPoint bldg:LP1_Energy_Meter .

bldg:LP1_Energy_Meter
  a brick:Electric_Energy_Meter ;
  rdfs:label "LP-1 Energy Meter" .

bldg:Lighting_Group_Floor_01
  a brick:Lighting_System ;
  rdfs:label "Floor 01 Lighting Group" ;
  brick:hasLocation bldg:Floor_01 .
