@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bldg: <https://example.com/building-management#> .

<https://example.com/building-management/modules/site-structure>
  a owl:Ontology ;
  rdfs:label "Building management - site structure module" ;
  owl:imports
    <https://w3id.org/bot#> ,
    <https://brickschema.org/schema/Brick#> .

bldg:Campus_01
  a brick:Campus ;
  rdfs:label "Corporate Campus" ;
  bot:hasBuilding bldg:Building_A .

bldg:Building_A
  a bot:Building ;
  a brick:Building ;
  rdfs:label "HQ Building A" ;
  bot:hasStorey bldg:Floor_01 ;
  bot:hasStorey bldg:Floor_02 .

bldg:Floor_01
  a bot:Storey ;
  a brick:Floor ;
  rdfs:label "Floor 01" ;
  bot:hasSpace bldg:Lobby_101 ;
  bot:hasSpace bldg:Office_102 .

bldg:Floor_02
  a bot:Storey ;
  a brick:Floor ;
  rdfs:label "Floor 02" ;
  bot:hasSpace bldg:Conference_201 .

bldg:Lobby_101
  a bot:Space ;
  a brick:Room ;
  rdfs:label "Lobby 101" .

bldg:Office_102
  a bot:Space ;
  a brick:Office ;
  rdfs:label "Office 102" .

bldg:Conference_201
  a bot:Space ;
  a brick:Conference_Room ;
  rdfs:label "Conference Room 201" .
